<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<panel
 border="true"
 follows="left|top|right|bottom"
 height="408"
 label="Move"
 layout="topleft"
 left="102"
 name="move_panel"
 top="1"
 width="517">
  <tab_container
    follows="all"
    top="-1"
    height="430"
    left="0"
    mouse_opaque="false"
    name="tabs"
    tab_min_width="50"
    tab_position="top"
    width="517"
    bg_opaque_color="0,0,0,0.0">

        <!--Camera-->
        <panel
            border="true"
            layout="topleft"
            follows="all"
            height="408"
            label="Camera"
            left="1"
            mouse_opaque="true"
            name="move_camera"
            width="517">
  <icon
     follows="left|top"
     height="18"
     image_name="Cam_FreeCam_Off"
     layout="topleft"
     name="camera_icon"
     mouse_opaque="false"
     visible="true"
     width="18"
     left="30"
     top="10"/>
  <slider
   can_edit_text="true"
   control_name="CameraAngle"
   decimal_digits="3"
   follows="left|top"
   height="16"
   increment="0.025"
   initial_value="1.57"
   layout="topleft"
   label_width="100"
   label="View angle"
   left_pad="30"
   max_val="2.97"
   min_val="0.17"
   name="camera_fov"
   show_text="true"
   width="240" />
  <slider
   can_edit_text="true"
   control_name="CameraOffsetScale"
   decimal_digits="3"
   follows="left|top"
   height="16"
   increment="0.025"
   initial_value="1"
   layout="topleft"
   label="Distance"
   left_delta="0"
   label_width="100"
   max_val="3"
   min_val="0.5"
   name="camera_offset_scale"
   show_text="true"
   width="240"
   top_pad="5"/>
  <check_box
   top_pad="6"
   follows="left|top"
   height="16"
   initial_value="false"
   label="Clicking your avatar keeps camera position"
   layout="topleft"
   left="74"
   name="clickonavatarkeepscamera"
   width="270"
   control_name="ClickOnAvatarKeepsCamera"
   tool_tip="Normally, clicking on your avatar resets the camera position. This option removes this behavior."/>
  <text
  follows="left|top"
  type="string"
  length="1"
  height="10"
  left="78"
  name="heading2"
  width="270"
  top_pad="3">
    Automatic position for:
  </text>
  <check_box
     control_name="EditCameraMovement"
     height="20"
     follows="left|top"
     label="Build/Edit"
     layout="topleft"
     left_delta="5"
     name="edit_camera_movement"
     tool_tip="Use automatic camera positioning when entering and exiting edit mode"
     width="280"
     top_pad="5" />
  <check_box
   control_name="AppearanceCameraMovement"
   follows="left|top"
   height="16"
   label="Appearance"
   layout="topleft"
   name="appearance_camera_movement"
   tool_tip="Use automatic camera positioning while in edit mode"
   width="242"
   top_pad="3"/>
  <check_box
   control_name="ResetViewTurnsAvatar"
   follows="left|top"
   height="16"
   label="Turn avatar towards camera direction on reset view"
   layout="topleft"
   name="resetviewturnsavatar"
   tool_tip="This option keeps the camera direction and turns the avatar when Reset View is selected (hit ESC key)."
   top_pad="3"
   width="350"/> 
        </panel>

				<!--Keyboard-->
        <panel
            border="true"
            layout="topleft"
            follows="all"
            height="408"
            label="Keyboard"
            left="1"
            mouse_opaque="true"
            name="move_keyboard"
            width="517">
 <icon
	 follows="left|top"
	 height="18"
	 image_name="Keyboard"
   layout="topleft"
	 name="avatar_icon"
	 mouse_opaque="false"
	 visible="true"
	 width="18"
   top="10"
   left="30" />
  <text
   follows="left|top"
   type="string"
   length="1"
   height="10"
   layout="topleft"
   left="78"
   name="keyboard_lbl"
   width="270"
   top_delta="2">
    Keyboard:
  </text>
  <check_box
   control_name="ArrowKeysAlwaysMove"
   follows="left|top"
   height="16"
   label="Arrow keys always move me"
   layout="topleft"
   left_delta="5"
   name="arrow_keys_move_avatar_check"
   width="237"
   top_pad="9"/>
  <check_box
   control_name="ResetCameraOnMovement"
   follows="left|top"
   height="16"
   label="Reset camera position on avatar movement"
   layout="topleft"
   left_delta="0"
   name="ResetCameraOnMovement"
   width="237"
   top_pad="3"/>
  <check_box
   control_name="AllowTapTapHoldRun"
   follows="left|top"
   height="16"
   label="Tap-tap-hold to run"
   layout="topleft"
   left_delta="0"
   name="tap_tap_hold_to_run"
   width="237"
   top_pad="3"/>
  <check_box
   control_name="AutomaticFly"
   follows="left|top"
   height="16"
   label="Hold jump or crouch key to start or stop flying"
   layout="topleft"
   left_delta="0"
   name="automatic_fly"
   width="237"
   top_pad="3"/>
  <check_box
   control_name="FSCrouchToggle"
   follows="left|top"
   height="16"
   label="Enable crouch toggle mode"
   layout="topleft"
   left_delta="0"
   name="crouch_toggle_mode"
   width="237"
   top_pad="3"/>
        </panel>

				<!--Mouse-->
        <panel
            border="true"
            layout="topleft"
            follows="all"
            height="408"
            label="Mouse"
            left="1"
            mouse_opaque="true"
            name="move_mouse"
            width="517">
  <icon
   follows="left|top"
   height="18"
   image_name="Mouse"
   layout="topleft"
   name="mouse_icon"
   mouse_opaque="false"
   visible="true"
   width="18"
   left="30"
   top="10"/>
  <text
   follows="left|top"
   type="string"
   length="1"
   height="10"
   layout="topleft"
   left="78"
   name="mouse_lbl"
   width="270"
   top_delta="0">
    Mouse:
  </text>
  <check_box
   control_name="FirstPersonAvatarVisible"
   follows="left|top"
   height="16"
   label="Show me in Mouselook"
   layout="topleft"
   left_delta="5"
   name="first_person_avatar_visible"
   top_pad="7"
   width="256" />
        <check_box
         control_name="FSEnableRightclickMenuInMouselook"
         follows="left|top"
         enabled_control="EnableMouselook"
         height="16"
         label="Enable context menus in Mouselook"
         layout="topleft"
         name="FSEnableRightclickMenuInMouselook"
         tool_tip="Opens pie/context menu in mouselook mode upon ALT + right mouse button"
         top_pad="3"
         width="256" />
  <text
   type="string"
   length="1"
   follows="left|top"
   height="15"
   layout="topleft"
   left_delta="3"
   name=" Mouse Sensitivity"
   top_pad="3"
   width="160"
   wrap="true">
    Mouselook mouse sensitivity
  </text>
  <slider
   control_name="MouseSensitivity"
   follows="left|top"
   height="15"
   initial_value="2"
   layout="topleft"
   show_text="false"
   left_pad="0"
   max_val="15"
   name="mouse_sensitivity"
   top_delta="-1"
   width="115" />
  <check_box
   control_name="InvertMouse"
   height="16"
   label="Invert"
   layout="topleft"
   left_pad="2"
   name="invert_mouse"
   top_delta="0"
   width="128" />
  <text
   name="Camera Sensitivity"
   type="string"
   layout="topleft"
   follows="left|top"
   height="15"
   width="160"
   top_pad="4"
   left="86"
   length="1"
   wrap="true">
    Camera mouse sensitivity
  </text>
  <slider
   name="camera_mouse_speed_multiplier"
   control_name="CameraMouseSpeedMultiplier"
   layout="topleft"
   follows="left|top"
   height="15"
   width="115"
   top_delta="-1"
   left_pad="0"
   min_val="0.1"
   max_val="2.0"
   initial_value="1.0"
   show_text="false" />
  <text
   follows="left|top"
   type="string"
   length="1"
   height="10"
   layout="topleft"
   left="86"
   name="mouse_warp_lbl"
   width="150"
   top_pad="10">
    Mouse Warp:
  </text>
  <combo_box
   control_name="MouseWarpMode"
   height="23"
   layout="topleft"
   left_pad="10"
   top_delta="-6"
   name="mouse_warp_combo"
   tooltip="Controls warping of the mouse to the center of the screen during alt-zoom and mouse look."
   width="200">
    <combo_box.item
     label="Automatic"
     name="0"
     value="0"/>
    <combo_box.item
     label="On"
     name="1"
     value="1"/>
    <combo_box.item
     label="Off"
     name="2"
     value="2"/>
  </combo_box>
  <text
   follows="left|top"
   type="string"
   length="1"
   height="10"
   layout="topleft"
   left="86"
   name="single_click_action_lbl"
   width="150"
   top_pad="12">
    Single click on land
  </text>
  <combo_box
   height="23"
   layout="topleft"
   left_pad="10"
   top_delta="-6"
   name="single_click_action_combo"
   width="200">
    <combo_box.item
     label="No action"
     name="0"
     value="0"/>
    <combo_box.item
     label="Move to clicked point"
     name="1"
     value="1"/>
    <combo_box.commit_callback
     function="Pref.ClickActionChange"/>
  </combo_box>
  <text
   follows="left|top"
   type="string"
   length="1"
   height="10"
   layout="topleft"
   left="86"
   name="double_click_action_lbl"
   width="150"
   top_pad="12">
    Double click on land
  </text>
  <combo_box
   height="23"
   layout="topleft"
   left_pad="10"
   top_delta="-6"
   name="double_click_action_combo"
   width="200">
    <combo_box.item
     label="No action"
     name="0"
     value="0"/>
    <combo_box.item
     label="Move to clicked point"
     name="1"
     value="1"/>
    <combo_box.item
     label="Teleport to clicked point"
     name="2"
     value="2"/>
    <combo_box.commit_callback
     function="Pref.ClickActionChange"/>
  </combo_box>
  <check_box
   control_name="EnableCollisionSounds"
   height="20"
   label="Play sound on collisions"
   layout="topleft"
   left="83"
   name="sound_on_collisions"
   top_pad="10"
   width="200" />
  <button
   height="23"
   label="Other Devices"
   left="30"
   name="joystick_setup_button"
   follows="left|top"
   top_pad="4"
   width="155">
    <button.commit_callback
     function="Floater.Show"
     parameter="pref_joystick" />
  </button>
    </panel>
  </tab_container>
</panel>
